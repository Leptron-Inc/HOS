# Copy to .env for local development (.env is git-ignored). Never commit real credentials or keys.
# `pnpm dev` and `pnpm start:local` read .env; `pnpm start` (production) never does.

# Required: development, test or production. There is no default.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Required by every process: this cell's ID (D-019).
HOS_CELL_ID=local-cell
LOG_LEVEL=info

# --- PostgreSQL, one connection per login role (tenancy specification §3.1) ---
# Required (API runtime, role hos_api). Example: postgres://hos_api@HOST:5432/hos
DATABASE_URL=
# Required by the API and workers (role hos_seclog_writer, P7 security log).
SECLOG_DATABASE_URL=
# Required by workers (roles hos_worker and hos_relay).
WORKER_DATABASE_URL=
RELAY_DATABASE_URL=
# Optional, workers: enables the integrity monitor (role hos_monitor, E-46(4)).
MONITOR_DATABASE_URL=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_HEALTH_TIMEOUT_MS=2000
DB_LOCK_TIMEOUT_MS=5000
HEALTH_CACHE_TTL_MS=2000

# --- Identity (P2) ---
# Required by the API: JSON array of trusted token issuers, each bound to one cell realm
# (hotel_employee, guest or machine) with an https JWKS URL. The identity provider is not chosen yet (D-021).
# [{"issuer":"https://idp.example/","audience":"hos-cell","realm":"hotel_employee","jwksUrl":"https://idp.example/.well-known/jwks.json"}]
HOS_IDENTITY_ISSUERS=
# The Control Plane provisioning identity (CX-15); both or neither.
HOS_PROVISIONING_ISSUER=
HOS_PROVISIONING_SUBJECT=
IAM_GRANTS_CACHE_TTL_MS=15000

# --- Security safeguards (P7) ---
RATE_LIMIT_PER_MINUTE=600
HTTP_BODY_LIMIT_BYTES=1048576
SECLOG_AGGREGATION_WINDOW_MS=10000

# --- Operations endpoints (P6): metrics and diagnostics; 0 disables. Never expose publicly. ---
OPS_PORT=0
OPS_HOST=127.0.0.1

# --- Local development stores (refused in production; production uses AWS Secrets Manager and S3) ---
# Keys are 32 random bytes, base64. Generate locally; never reuse or commit them.
HOS_LOCAL_SECRETS_DIR=
HOS_LOCAL_SECRETS_KEY=
HOS_DOCUMENT_STORAGE_DIR=
HOS_DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_MAX_BYTES=10485760
# Allows plain-HTTP connector endpoints in development only.
INTEGRATION_ALLOW_INSECURE_HTTP=false

HOS_BUILD_VERSION=development

# --- Database tooling (local and test only) ---
# HOS_DB_ADMIN_URL: administrator of a THROWAWAY cluster, for `pnpm db:bootstrap`.
# HOS_DB_MIGRATOR_URL: role hos_migrator, for `pnpm db:migrate`.
# HOS_TEST_ADMIN_URL: administrator of a throwaway cluster, for `pnpm test:integration`.
