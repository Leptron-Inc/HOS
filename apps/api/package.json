{
  "name": "@hos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "start:local": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:bootstrap": "node dist/kernel/database/migration/cli.js bootstrap",
    "db:migrate": "node dist/kernel/database/migration/cli.js migrate",
    "db:lint": "node dist/kernel/database/migration/cli.js lint"
  },
  "dependencies": {
    "@hos/shared": "workspace:*",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hos/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
