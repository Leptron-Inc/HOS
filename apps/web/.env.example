# Copy to .env.local for local overrides (git-ignored).
# Base path the browser uses for API calls. The dev/preview servers proxy /api to the API.
VITE_API_BASE_URL=/api
# Where the dev/preview proxy forwards /api requests (read by vite.config.ts, not by the browser).
HOS_API_PROXY_TARGET=http://127.0.0.1:3000
